---
import { Image } from "astro:assets";
import {
  articlesBase,
  formatDate,
  formatNumber,
  getReadingMinutes,
  ui,
  type Article,
} from "../../utils/articles";

interface Props {
  article: Article;
}

const { article } = Astro.props;
const d = article.data;
const t = ui[d.lang];
const minutes = getReadingMinutes(article.body);
---

<a
  href={`${articlesBase(d.lang)}/${article.id}`}
  data-card
  data-tags={d.tags.join("|")}
  data-search={`${d.title} ${d.description}`.toLowerCase()}
  dir={d.lang === "fa" ? "rtl" : "ltr"}
  lang={d.lang}
  class={`${d.lang === "fa" ? "font-fa" : ""} card group flex flex-col overflow-hidden transition-shadow duration-200 hover:shadow-lift`}
>
  {
    d.coverImage ? (
      <Image
        src={d.coverImage}
        alt={d.title}
        width={640}
        format="webp"
        class="aspect-[16/9] w-full h-auto object-cover"
      />
    ) : (
      <div
        class="aspect-[16/9] w-full bg-ink flex items-center justify-center text-brand font-mono text-5xl font-bold"
        aria-hidden="true"
      >
        {"{ }"}
      </div>
    )
  }
  <div class="flex flex-col flex-1 p-5 sm:p-6">
    <div class="flex flex-wrap gap-2 mb-3">
      <span class="text-xs font-semibold text-muted bg-canvas px-2.5 py-1 rounded-full">
        {d.lang === "fa" ? "فارسی" : "English"}
      </span>
      {
        d.tags.map((tag) => (
          <span class="text-xs font-semibold text-brand-ink bg-brand-soft px-2.5 py-1 rounded-full">
            <bdi dir="ltr">#{tag}</bdi>
          </span>
        ))
      }
    </div>
    <h2
      class="text-lg sm:text-xl font-bold text-ink mb-2 leading-[1.6]"
    >
      {d.title}
    </h2>
    <p class="text-muted text-[15px] leading-7 mb-5 flex-1">
      {d.description}
    </p>
    <div class="flex flex-wrap items-center gap-x-2 gap-y-1 border-t border-line pt-4 text-sm text-muted">
      <span class="font-semibold text-ink">{d.author}</span>
      <span aria-hidden="true">•</span>
      <time datetime={d.pubDate.toISOString()}
        >{formatDate(d.pubDate, d.lang)}</time
      >
      <span aria-hidden="true">•</span>
      <span>{formatNumber(minutes, d.lang)} {t.minutes}</span>
    </div>
  </div>
</a>
