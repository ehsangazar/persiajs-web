---
interface Props {
  variant?: "primary" | "secondary" | "ghost" | "outline";
  size?: "sm" | "md" | "lg";
  href?: string;
  class?: string;
  [key: string]: unknown;
}

const {
  variant = "primary",
  size = "md",
  href,
  class: className = "",
  ...rest
} = Astro.props;

const baseStyles =
  "inline-flex items-center justify-center text-center rounded-xl font-semibold transition-colors duration-200 ease-out disabled:opacity-50 disabled:cursor-not-allowed";

// Tap targets: 44px minimum, 48px for the large size
const sizes = {
  sm: "px-4 py-2 text-sm min-h-[44px] gap-2",
  md: "px-5 py-3 text-base min-h-[48px] gap-2.5",
  lg: "px-7 py-3.5 text-base min-h-[52px] gap-2.5",
};

// Primary is the one yellow element on a page: yellow background, ink text
const variants = {
  primary:
    "bg-brand text-ink hover:bg-brand-strong active:bg-brand-strong shadow-card",
  secondary: "bg-ink text-white hover:bg-ink-soft active:bg-ink-soft",
  ghost: "bg-transparent text-ink hover:bg-canvas",
  outline:
    "bg-surface text-ink border border-line-strong hover:border-ink active:bg-canvas",
};

const classes = `${baseStyles} ${sizes[size]} ${variants[variant]} ${className}`;
const hasLeftIcon = Astro.slots.has("left-icon");
const hasRightIcon = Astro.slots.has("right-icon");
---

{
  href ? (
    <a href={href} class={classes} {...rest}>
      {hasLeftIcon && (
        <span class="flex-shrink-0">
          <slot name="left-icon" />
        </span>
      )}
      <span>
        <slot />
      </span>
      {hasRightIcon && (
        <span class="flex-shrink-0">
          <slot name="right-icon" />
        </span>
      )}
    </a>
  ) : (
    <button type="button" class={classes} {...rest}>
      {hasLeftIcon && (
        <span class="flex-shrink-0">
          <slot name="left-icon" />
        </span>
      )}
      <span>
        <slot />
      </span>
      {hasRightIcon && (
        <span class="flex-shrink-0">
          <slot name="right-icon" />
        </span>
      )}
    </button>
  )
}
