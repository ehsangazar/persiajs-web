---
interface Props {
  label?: string;
  title: string;
  subtitle?: string;
  class?: string;
  as?: "h1" | "h2" | "div";
}

// Quiet on purpose: a small muted eyebrow, an ink heading, a muted subtitle.
// No pills and no coloured words; typography and whitespace carry it.
const { label, title, subtitle, class: className = "", as: Tag = "h2" } = Astro.props;
---

<div class={`text-center mb-10 md:mb-14 ${className}`}>
  {label && <p class="mb-3 text-sm font-semibold text-muted">{label}</p>}
  <Tag
    class="text-2xl sm:text-3xl md:text-4xl font-bold text-ink leading-[1.5] text-balance"
  >
    {title}
  </Tag>
  {
    subtitle && (
      <p class="text-base md:text-lg text-muted max-w-2xl mx-auto leading-8 mt-4 text-pretty">
        {subtitle}
      </p>
    )
  }
</div>
