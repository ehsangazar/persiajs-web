---
interface Props {
  label?: string;
  title: string;
  subtitle?: string;
  class?: string;
  as?: "h1" | "h2" | "div";
}

const { label, title, subtitle, class: className = "", as: Tag = "h2" } = Astro.props;

// Words that get the yellow highlighter stroke
const highlightWords = ["JS", "JavaScript", "PersiaJS", "Team", "Community"];
const words = title.split(" ").map((word) => ({
  word,
  highlight: highlightWords.some((hw) => word.includes(hw)),
}));
---

<div class={`text-center mb-10 md:mb-14 ${className}`}>
  {
    label && (
      <span class="inline-flex items-center gap-2 mb-4 rounded-full bg-brand-soft px-3.5 py-1.5 text-sm font-semibold text-brand-ink">
        <span class="h-1.5 w-1.5 rounded-full bg-brand-ink" aria-hidden="true" />
        {label}
      </span>
    )
  }
  <Tag
    class="font-display text-3xl sm:text-4xl md:text-5xl font-extrabold text-ink leading-[1.35] text-balance"
  >
    {
      words.map(({ word, highlight }) =>
        highlight ? (
          <>
            <span class="hl-marker">{word}</span>{" "}
          </>
        ) : (
          <>{word} </>
        )
      )
    }
  </Tag>
  {
    subtitle && (
      <p class="text-base md:text-lg text-muted max-w-2xl mx-auto leading-8 mt-4 text-pretty">
        {subtitle}
      </p>
    )
  }
</div>
