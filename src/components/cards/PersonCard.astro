---
import type { Person } from "../../types";
import { withBase } from "../../utils/url";

interface Props {
  person: Person;
  class?: string;
}

const { person, class: className = "" } = Astro.props;
---

<div class={`card group relative flex h-full flex-col p-2.5 sm:p-3 ${className}`}>
  <!-- bg-canvas is the placeholder while the image loads -->
  <div class="aspect-square overflow-hidden rounded-xl bg-canvas">
    <img
      src={withBase(`/${person.image.replace(/^\/+/, "")}`)}
      alt={person.name}
      loading="lazy"
      class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.03]"
    />
  </div>
  {
    person.linkedin && (
      <a
        href={person.linkedin}
        target="_blank"
        rel="noopener noreferrer"
        class="absolute top-4 end-4 sm:top-5 sm:end-5 flex h-10 w-10 items-center justify-center rounded-xl bg-surface/95 text-ink shadow-card transition-colors hover:bg-canvas"
        aria-label={`لینکدین ${person.name}`}
      >
        <svg class="h-[18px] w-[18px]" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z" />
        </svg>
      </a>
    )
  }
  <div class="px-1.5 pt-3 pb-1 sm:px-2 sm:pt-4">
    <h3 class="text-sm font-bold leading-6 text-ink break-words sm:text-base" lang="en">
      {person.name}
    </h3>
    <p class="text-xs text-muted sm:text-sm">{person.title}</p>
  </div>
</div>
