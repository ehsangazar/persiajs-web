---
import Container from "../layout/Container.astro";
import SectionTitle from "../ui/SectionTitle.astro";
import aboutData from "../../data/about.json";
import socialData from "../../data/social.json";
import type { AboutContent } from "../../types";
import { withBase } from "../../utils/url";

const about = aboutData as AboutContent;
const telegramUrl = socialData.links.find((l) => l.platform === "Telegram")?.url;

// The three things PersiaJS actually is, each with somewhere to go
const pillars = [
  {
    title: "مقاله‌های فارسی",
    text: "نوشته‌هایی درباره‌ی جاوااسکریپت، ری‌اکت، Node.js و وب، به قلم اعضای جامعه.",
    href: withBase("/fa/articles"),
    cta: "خواندن مقاله‌ها",
    icon: "M4 6h16M4 10h16M4 14h10M4 18h7",
  },
  {
    title: "رویدادها و سخنرانی‌ها",
    text: "رویدادهای آنلاین و حضوری که در گذشته برگزار شده‌اند، با سخنرانانی از خود جامعه.",
    href: "#events",
    cta: "رویدادهای گذشته",
    icon: "M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z",
  },
  {
    title: "گروه تلگرام",
    text: "جایی برای پرسیدن، کمک کردن و شنیدن خبر رویداد بعدی.",
    href: telegramUrl,
    cta: "پیوستن به گروه",
    external: true,
    icon: "M8 10h.01M12 10h.01M16 10h.01M21 12c0 4.418-4.03 8-9 8a9.86 9.86 0 01-4-.84L3 20l1.3-3.9A7.96 7.96 0 013 12c0-4.418 4.03-8 9-8s9 3.582 9 8z",
  },
];
---

<section id="about" class="py-16 md:py-28 bg-surface border-y border-line">
  <Container>
    <SectionTitle label="درباره ما" title={about.title} />

    <div class="mx-auto max-w-3xl space-y-5 text-base leading-[1.95] text-ink-soft md:text-lg">
      {about.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
    </div>

    <div class="mt-12 grid gap-4 md:grid-cols-3 md:gap-6">
      {
        pillars.map((p) => (
          <a
            href={p.href}
            target={p.external ? "_blank" : undefined}
            rel={p.external ? "noopener noreferrer" : undefined}
            class="card group flex flex-col p-6 transition-shadow duration-200 hover:shadow-lift"
          >
            <span class="flex h-12 w-12 items-center justify-center rounded-xl bg-brand-soft text-ink">
              <svg
                class="h-6 w-6"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                viewBox="0 0 24 24"
                aria-hidden="true"
              >
                <path d={p.icon} />
              </svg>
            </span>
            <h3 class="mt-5 text-xl font-bold text-ink">{p.title}</h3>
            <p class="mt-2 flex-1 text-base leading-7 text-muted">{p.text}</p>
            <span class="mt-5 inline-flex items-center gap-1.5 text-sm font-bold text-brand-ink">
              {p.cta}
              <span aria-hidden="true" class="transition-transform group-hover:-translate-x-1">←</span>
            </span>
          </a>
        ))
      }
    </div>
  </Container>
</section>
