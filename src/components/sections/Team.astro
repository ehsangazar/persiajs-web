---
import Container from "../layout/Container.astro";
import SectionTitle from "../ui/SectionTitle.astro";
import PersonCard from "../cards/PersonCard.astro";
import ActionCardComponent from "../cards/ActionCard.astro";
import teamData from "../../data/team.json";
import socialData from "../../data/social.json";
import type { TeamMember, ActionCard } from "../../types";

const team = teamData as { members: TeamMember[] };
const social = socialData as {
  links: Array<{ platform: string; url: string }>;
};

const telegramLink =
  social.links.find((link) => link.platform === "Telegram")?.url || "#contact";

const joinTeamCard: ActionCard = {
  id: "join-team",
  icon: "paperPlane",
  title: "به تیم بپیوندید",
  description: "می‌خواهید در اداره‌ی PersiaJS کمک کنید؟",
  buttonText: "پیام در تلگرام",
  buttonLink: telegramLink,
};
---

<section id="team" class="py-16 md:py-28 bg-surface border-y border-line">
  <Container>
    <SectionTitle
      label="تیم"
      title="تیم PersiaJS"
      subtitle="کسانی که PersiaJS را می‌سازند و می‌گردانند"
    />

    <!-- Team Member Cards -->
    <div
      class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-3 sm:gap-5 mb-12"
    >
      {
        team.members.map((member) => (
          <div>
            <PersonCard person={member} />
          </div>
        ))
      }
    </div>

    <!-- Join Team Card -->
    <div class="max-w-md mx-auto">
      <ActionCardComponent card={joinTeamCard} />
    </div>
  </Container>
</section>
