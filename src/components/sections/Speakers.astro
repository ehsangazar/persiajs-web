---
import Container from "../layout/Container.astro";
import SectionTitle from "../ui/SectionTitle.astro";
import PersonCard from "../cards/PersonCard.astro";
import speakersData from "../../data/speakers.json";
import type { Speaker } from "../../types";

const speakers = speakersData as { speakers: Speaker[] };
---

<section id="speakers" class="py-16 md:py-28">
  <Container>
    <SectionTitle
      label="سخنرانان"
      title="سخنرانان PersiaJS"
      subtitle="توسعه‌دهندگانی که در رویدادهای PersiaJS تجربه‌شان را به اشتراک گذاشته‌اند"
    />

    <!-- Speaker Cards -->
    <div
      class="mx-auto grid max-w-3xl grid-cols-2 md:grid-cols-3 gap-3 sm:gap-5"
    >
      {
        speakers.speakers.map((speaker) => (
          <div>
            <PersonCard person={speaker} />
          </div>
        ))
      }
    </div>
  </Container>
</section>
