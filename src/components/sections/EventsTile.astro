---
import Container from "../layout/Container.astro";
import SectionTitle from "../ui/SectionTitle.astro";
import Button from "../ui/Button.astro";
import { PAST_EVENTS, PAST_TOTALS } from "../../data/events";
import socialData from "../../data/social.json";
import { withBase } from "../../utils/url";

const telegramUrl = socialData.links.find((l) => l.platform === "Telegram")?.url;
---

<section id="events" class="py-16 md:py-28">
  <Container>
    <SectionTitle
      label="رویدادها"
      title="رویدادهای گذشته"
      subtitle="رویدادهای PersiaJS برنامه‌ی ثابتی ندارند. خبر رویداد بعدی در گروه تلگرام اعلام می‌شود."
    />

    <div class="mx-auto grid max-w-5xl gap-6 lg:grid-cols-[1.4fr_1fr]">
      <div class="space-y-4">
        {
          PAST_EVENTS.map((event) => {
            const Tag = event.href ? "a" : "div";
            return (
              <Tag
                href={event.href ? withBase(event.href) : undefined}
                class={`card group flex gap-4 p-5 sm:p-6 ${event.href ? "transition-shadow duration-200 hover:shadow-lift" : ""}`}
              >
                <div class="flex h-16 w-16 shrink-0 flex-col items-center justify-center rounded-xl bg-brand text-ink">
                  <span class="font-display text-xl font-extrabold leading-none">{event.day}</span>
                  <span class="mt-1 text-xs font-semibold">{event.month}</span>
                </div>
                <div class="min-w-0 flex-1">
                  <div class="flex flex-wrap items-center gap-2 text-xs font-semibold">
                    <span class="rounded-full bg-canvas px-2.5 py-1 text-muted">برگزار شد</span>
                    <span class="rounded-full bg-canvas px-2.5 py-1 text-muted">{event.location}</span>
                  </div>
                  <h3
                    dir="ltr"
                    lang="en"
                    class="mt-3 text-start text-lg font-bold leading-snug text-ink sm:text-xl"
                  >
                    {event.title}
                  </h3>
                  <p class="mt-1 text-sm text-muted">{event.date}</p>
                  {event.href && (
                    <span class="mt-3 inline-flex items-center gap-1.5 text-sm font-bold text-brand-ink">
                      جزئیات و سخنرانی‌ها
                      <span aria-hidden="true" class="transition-transform group-hover:-translate-x-1">←</span>
                    </span>
                  )}
                </div>
              </Tag>
            );
          })
        }
      </div>

      <!-- Past totals, as the old PersiaJS site showed them -->
      <div class="flex flex-col rounded-2xl bg-ink p-6 text-white sm:p-8">
        <p class="font-display text-lg font-bold">در رویدادهای گذشته</p>
        <p class="mt-1 text-sm text-[#c9cdd4]">مجموع، به نقل از سایت قبلی PersiaJS</p>
        <div class="mt-6 grid grid-cols-2 gap-x-4 gap-y-5">
          {
            PAST_TOTALS.map((item) => (
              <div>
                <p class="font-display text-3xl font-extrabold text-brand">{item.value}</p>
                <p class="text-sm text-[#c9cdd4]">{item.label}</p>
              </div>
            ))
          }
        </div>
        <div class="mt-8 pt-2 lg:mt-auto">
          <Button
            href={telegramUrl}
            target="_blank"
            rel="noopener noreferrer"
            variant="primary"
            size="md"
            class="w-full"
          >
            خبر رویداد بعدی در تلگرام
          </Button>
        </div>
      </div>
    </div>
  </Container>
</section>
