---
import Container from "../layout/Container.astro";
import Button from "../ui/Button.astro";
import socialData from "../../data/social.json";
import type { SocialLink } from "../../types";
import { withBase } from "../../utils/url";

const social = socialData as { links: SocialLink[] };
const telegramUrl = social.links.find((l) => l.platform === "Telegram")?.url;

---

<section
  id="hero"
  aria-label="معرفی PersiaJS"
  class="bg-canvas pt-32 pb-20 md:pt-44 md:pb-28"
>
  <Container class="text-center">
    <h1
      class="hero-in mx-auto max-w-3xl font-display text-[2.1rem] leading-[1.45] font-extrabold text-ink sm:text-5xl sm:leading-[1.4] lg:text-6xl text-balance"
    >
      جامعه‌ی توسعه‌دهندگان فارسی‌زبان
      <span class="hl-marker">جاوااسکریپت</span>
    </h1>

    <p
      class="hero-in mx-auto mt-6 max-w-xl text-base leading-8 text-muted sm:text-lg"
      style="animation-delay: 100ms"
    >
      مقاله‌های فارسی، رویدادها و سخنرانی‌های آنلاین، و گروهی در تلگرام که
      اعضا در آن سؤال می‌پرسند و به هم کمک می‌کنند.
    </p>

    <div
      class="hero-in mt-9 flex flex-col gap-3 sm:flex-row sm:justify-center"
      style="animation-delay: 200ms"
    >
      <Button
        href={telegramUrl}
        target="_blank"
        rel="noopener noreferrer"
        variant="primary"
        size="lg"
      >
        پیوستن به گروه تلگرام
      </Button>
      <Button href={withBase("/fa/articles")} variant="outline" size="lg">
        خواندن مقاله‌ها
      </Button>
    </div>
  </Container>
</section>

<style>
  @keyframes hero-in {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  .hero-in {
    animation: hero-in 0.6s ease-out both;
  }
</style>
