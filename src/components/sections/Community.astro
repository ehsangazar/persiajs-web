---
import Container from "../layout/Container.astro";
import SocialIcon from "../ui/SocialIcon.astro";
import Button from "../ui/Button.astro";
import socialData from "../../data/social.json";
import type { SocialLink } from "../../types";

const social = socialData as { links: SocialLink[] };
const telegramUrl = social.links.find((l) => l.platform === "Telegram")?.url;
const others = social.links.filter((l) => l.platform !== "Telegram");
---

<section id="community" class="py-16 md:py-28">
  <Container>
    <div class="relative overflow-hidden rounded-3xl bg-ink px-6 py-12 text-center sm:px-10 md:py-16">
      <!-- A soft yellow glow in one corner -->
      <div
        class="pointer-events-none absolute -top-24 -start-24 h-64 w-64 rounded-full bg-brand opacity-20 blur-3xl"
        aria-hidden="true"
      >
      </div>

      <span class="relative inline-flex rounded-full bg-white/10 px-3.5 py-1.5 text-sm font-semibold text-brand">
        در ارتباط باشیم
      </span>
      <h2 class="relative mt-5 font-display text-3xl font-extrabold leading-[1.4] text-white sm:text-4xl md:text-5xl text-balance">
        به جامعه‌ی ما بپیوندید
      </h2>
      <p class="relative mx-auto mt-4 max-w-xl text-base leading-8 text-[#c9cdd4] md:text-lg">
        با توسعه‌دهندگان دیگر آشنا شوید، سؤال بپرسید و خبر رویداد بعدی را زودتر از همه بشنوید.
      </p>

      <div class="relative mt-8 flex justify-center">
        <Button
          href={telegramUrl}
          target="_blank"
          rel="noopener noreferrer"
          variant="primary"
          size="lg"
        >
          <span class="inline-flex items-center gap-2">
            <SocialIcon platform="telegram" class="h-5 w-5" />
            پیوستن به گروه تلگرام
          </span>
        </Button>
      </div>

      <div class="relative mt-8 flex flex-wrap justify-center gap-2">
        {
          others.map((link) => (
            <a
              href={link.url}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`PersiaJS در ${link.platform}`}
              class="flex h-11 w-11 items-center justify-center rounded-xl border border-white/15 text-white transition-colors hover:border-brand hover:bg-brand hover:text-ink"
            >
              <SocialIcon platform={link.icon || "linkedin"} class="h-5 w-5" />
            </a>
          ))
        }
      </div>
    </div>
  </Container>
</section>
