---
import Container from "../layout/Container.astro";
import SocialIcon from "../ui/SocialIcon.astro";
import Button from "../ui/Button.astro";
import socialData from "../../data/social.json";
import type { SocialLink } from "../../types";

const social = socialData as { links: SocialLink[] };
const telegramUrl = social.links.find((l) => l.platform === "Telegram")?.url;
const others = social.links.filter((l) => l.platform !== "Telegram");
---

<section id="community" class="py-16 md:py-28">
  <Container>
    <div class="card mx-auto max-w-3xl px-6 py-12 text-center sm:px-10 md:py-16">
      <h2 class="font-display text-3xl font-extrabold leading-[1.4] text-ink sm:text-4xl text-balance">
        به جامعه‌ی ما بپیوندید
      </h2>
      <p class="mx-auto mt-4 max-w-xl text-base leading-8 text-muted md:text-lg">
        با توسعه‌دهندگان دیگر آشنا شوید، سؤال بپرسید و خبر رویداد بعدی را زودتر از همه بشنوید.
      </p>

      <div class="mt-8 flex justify-center">
        <Button
          href={telegramUrl}
          target="_blank"
          rel="noopener noreferrer"
          variant="primary"
          size="lg"
        >
          پیوستن به گروه تلگرام
        </Button>
      </div>

      <div class="mt-8 flex flex-wrap justify-center gap-2">
        {
          others.map((link) => (
            <a
              href={link.url}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`PersiaJS در ${link.platform}`}
              class="flex h-11 w-11 items-center justify-center rounded-xl border border-line text-muted transition-colors hover:border-ink hover:text-ink"
            >
              <SocialIcon platform={link.icon || "linkedin"} class="h-5 w-5" />
            </a>
          ))
        }
      </div>
    </div>
  </Container>
</section>
