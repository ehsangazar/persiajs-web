---
import Container from "../layout/Container.astro";
import SectionTitle from "../ui/SectionTitle.astro";
import faqData from "../../data/faq.json";
import type { FAQItem } from "../../types";
import { formatNumber } from "../../utils/articles";

const faq = faqData as { items: FAQItem[] };
---

<section id="faq" class="py-16 md:py-28 bg-surface border-y border-line">
  <Container>
    <SectionTitle
      label="پرسش‌های رایج"
      title="پرسش‌های رایج"
      subtitle="آنچه باید درباره‌ی PersiaJS بدانید"
    />
    <div class="mx-auto max-w-3xl space-y-3">
      {
        faq.items.map((item, index) => (
          // name="faq" makes the browser keep only one item open at a time
          <details
            name="faq"
            class="group rounded-2xl border border-line bg-canvas transition-colors open:border-line-strong open:bg-surface open:shadow-card"
          >
            <summary class="flex min-h-[56px] cursor-pointer list-none items-center gap-4 px-4 py-4 text-start sm:px-6 [&::-webkit-details-marker]:hidden">
              <span class="faq-badge flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-surface text-sm font-bold text-muted border border-line">
                {formatNumber(index + 1, "fa")}
              </span>
              <span class="flex-1 text-base font-bold leading-7 text-ink md:text-lg">
                {item.question}
              </span>
              <svg
                class="faq-chevron h-5 w-5 shrink-0 text-muted transition-transform duration-300"
                fill="none"
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                viewBox="0 0 24 24"
                stroke="currentColor"
                aria-hidden="true"
              >
                <path d="M19 9l-7 7-7-7" />
              </svg>
            </summary>

            <div class="px-4 pb-5 sm:px-6 sm:ps-[4.5rem]">
              <p class="text-base leading-8 text-ink-soft">{item.answer}</p>
            </div>
          </details>
        ))
      }
    </div>
  </Container>
</section>

<style>
  /* Open state: numbered badge turns yellow and the arrow flips */
  details[open] .faq-badge {
    background: var(--color-brand);
    border-color: var(--color-brand);
    color: var(--color-ink);
  }
  details[open] .faq-chevron {
    transform: rotate(180deg);
  }

  /* Smooth open/close in browsers that support it (others open instantly) */
  details {
    interpolate-size: allow-keywords;
  }
  details::details-content {
    height: 0;
    overflow: clip;
    transition:
      height 0.3s ease,
      content-visibility 0.3s allow-discrete;
  }
  details[open]::details-content {
    height: auto;
  }
</style>
