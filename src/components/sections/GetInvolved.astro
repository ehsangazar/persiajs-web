---
import Container from "../layout/Container.astro";
import SectionTitle from "../ui/SectionTitle.astro";
import ActionCardComponent from "../cards/ActionCard.astro";
import socialData from "../../data/social.json";
import type { ActionCard } from "../../types";

const social = socialData as {
  speakerApplicationForm: string;
  sponsorForm: string;
};

const actionCards: ActionCard[] = [
  {
    id: "become-speaker",
    icon: "microphone",
    title: "سخنران شوید",
    description: "دانش و تجربه‌تان را با دیگران به اشتراک بگذارید",
    buttonText: "درخواست سخنرانی",
    buttonLink: social.speakerApplicationForm,
  },
  {
    id: "become-sponsor",
    icon: "lightning",
    title: "حامی شوید",
    description: "از جامعه‌ی توسعه‌دهندگان فارسی‌زبان حمایت کنید",
    buttonText: "حمایت از PersiaJS",
    buttonLink: social.sponsorForm,
  },
];
---

<section id="get-involved" class="py-20 md:py-32 bg-white">
  <Container>
    <SectionTitle
      label="مشارکت"
      title="در PersiaJS مشارکت کنید"
      subtitle="اگر می‌خواهید در جامعه‌ی توسعه‌دهندگان فارسی‌زبان سهمی داشته باشید"
    />

    <!-- Action Cards -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 items-stretch">
      {
        actionCards.map((card) => (
          <div class="h-full">
            <ActionCardComponent card={card} />
          </div>
        ))
      }
    </div>
  </Container>
</section>
