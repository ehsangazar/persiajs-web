---
import Container from "../layout/Container.astro";
import SectionTitle from "../ui/SectionTitle.astro";
import { courses, courseUrl } from "../../data/courses";
---

<section id="courses" class="py-16 md:py-28">
  <Container>
    <SectionTitle
      label="دوره‌ها"
      title="دوره‌های آموزشی در مکتب‌خونه"
      subtitle="دوره‌های ویدیویی جاوااسکریپت، ری‌اکت، Node.js و فرانت‌اند که هم‌بنیان‌گذار PersiaJS در مکتب‌خونه تدریس می‌کند."
    />

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3 sm:gap-5">
      {
        courses.map((course) => (
          <a
            href={courseUrl(course.slug)}
            target="_blank"
            rel="noopener"
            class="card group flex flex-col p-5 transition-colors duration-200 hover:border-line-strong"
          >
            <h3 class="flex-1 text-base font-bold leading-7 text-ink">
              {course.title}
              {course.free && <span class="ms-1 text-sm font-normal text-muted">(رایگان)</span>}
            </h3>
            <span class="mt-4 inline-flex items-center gap-1.5 text-sm font-semibold text-muted group-hover:text-ink">
              مشاهده در مکتب‌خونه
              <span aria-hidden="true" class="transition-transform group-hover:-translate-x-1">←</span>
            </span>
          </a>
        ))
      }
    </div>

    <p class="mt-8 text-center text-sm text-muted">
      این لینک‌ها کد معرفی مدرس را دارند.
    </p>
  </Container>
</section>
