---
// The one English page: a short About for people who do not read Persian.
// Everything else on the site is Persian-first.
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/layout/Header";
import Footer from "../../components/layout/Footer.astro";
import Container from "../../components/layout/Container.astro";
import SectionTitle from "../../components/ui/SectionTitle.astro";
import Button from "../../components/ui/Button.astro";
import socialData from "../../data/social.json";
import { EVENT_SLUG } from "../../data/events";
import { withBase } from "../../utils/url";

const telegramUrl = socialData.links.find((l) => l.platform === "Telegram")?.url;
const linkClass = "text-ink font-semibold underline decoration-brand-strong decoration-[3px] underline-offset-4 hover:bg-brand-soft";
---

<BaseLayout
  lang="en"
  title="About PersiaJS | Persian-speaking JavaScript developers"
  description="PersiaJS is a community of Persian-speaking JavaScript and web developers: Persian articles, past online events and a Telegram group where members help each other."
>
  <div class="min-h-screen">
    <Header client:load currentPath={Astro.url.pathname} lang="en" />
    <main class="pt-28 pb-16 md:pt-36 md:pb-24">
      <Container>
        <SectionTitle
          as="h1"
          label="ABOUT"
          title="About PersiaJS"
          subtitle="A community of Persian-speaking JavaScript and web developers"
        />

        <div class="max-w-3xl mx-auto space-y-6 text-ink-soft text-lg leading-relaxed">
          <p>
            PersiaJS brings together Persian-speaking developers who work with
            JavaScript and the web. Its centre is a Telegram group of about 300
            members, where people ask questions, share what they have learned
            and help each other.
          </p>
          <p>
            The site publishes
            <a href={withBase("/fa/articles")} class={linkClass}>articles in Persian</a>
            on JavaScript, React, Node.js, TypeScript and the wider web, written
            by community members.
          </p>
          <p>
            PersiaJS has run meetups and talks in the past. By the old site's
            count that came to 10 events, 392 attendees, 4 cities, 17 speakers
            and 82 companies. The two most recent events were online:
            PersiaJS #11, a Devconnect Argentina warmup, on 12 October 2025, and
            <a href={withBase(`/events/${EVENT_SLUG}`)} class={linkClass}
              >Design Systems &amp; Web Components</a
            > on 1 December 2025. Events do not run on a fixed schedule; the next
            one will be announced in the Telegram group.
          </p>
          <p>
            You can also follow PersiaJS on
            <a href="https://www.youtube.com/@persiajs" target="_blank" rel="noopener noreferrer" class={linkClass}>YouTube</a>
            and
            <a href="https://www.twitch.tv/persiajs" target="_blank" rel="noopener noreferrer" class={linkClass}>Twitch</a>,
            and find video courses in Persian by the PersiaJS co-founder in the
            <a href={withBase("/#courses")} class={linkClass}>courses section</a>.
          </p>

          <div class="flex flex-wrap gap-3 pt-4">
            <Button href={telegramUrl} target="_blank" rel="noopener noreferrer" variant="primary">
              Join the Telegram group
            </Button>
            <Button href={withBase("/")} variant="outline" lang="fa">
              نسخه‌ی فارسی
            </Button>
          </div>
        </div>
      </Container>
    </main>
    <Footer />
  </div>
</BaseLayout>
