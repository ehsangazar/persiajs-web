---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/layout/Header";
import Footer from "../components/layout/Footer.astro";
import Container from "../components/layout/Container.astro";
import Button from "../components/ui/Button.astro";
import { withBase } from "../utils/url";
---

<BaseLayout
  title="صفحه پیدا نشد | PersiaJS"
  description="صفحه‌ای که دنبالش هستید وجود ندارد."
>
  <div class="min-h-screen flex flex-col">
    <Header client:load currentPath={Astro.url.pathname} />
    <main class="flex-1 flex items-center justify-center py-32">
      <Container class="text-center">
        <p class="text-ink font-bold text-lg mb-2">404</p>
        <h1 class="text-4xl md:text-5xl font-bold text-ink mb-4">
          صفحه پیدا نشد
        </h1>
        <p class="text-ink-soft text-lg mb-8 max-w-xl mx-auto">
          صفحه‌ای که دنبالش هستید وجود ندارد یا جابه‌جا شده است.
        </p>
        <div class="flex flex-wrap justify-center gap-3">
          <Button href={withBase("/")} variant="primary">صفحه‌ی اصلی</Button>
          <Button href={withBase("/fa/articles")} variant="outline">مقالات</Button>
        </div>
      </Container>
    </main>
    <Footer />
  </div>
</BaseLayout>
